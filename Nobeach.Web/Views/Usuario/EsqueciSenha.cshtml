@{
    ViewData["Title"] = "Recuperar senha";
}

<div class="container mt-5" style="max-width:500px">

    <h2>Recuperar senha</h2>

    <p>
        Informe o e-mail utilizado no cadastro.
    </p>

    <form asp-action="EsqueciSenha" method="post">

        <div class="mb-3">

            <label>E-mail</label>

            <input
                type="email"
                name="email"
                class="form-control"
                required />

        </div>

        <button class="btn btn-primary">

            Enviar link de recuperação

        </button>

    </form>

</div>